# ghost-drone configuration
# Copy this file to ghost_drone.toml in the directory where you run ghost-drone.
# All three keys are required.

# Use 127.0.0.1 when running outside a devcontainer
# zenoh_endpoint = "tcp/127.0.0.1:7447"
zenoh_endpoint = "tcp/host.docker.internal:7447"
keelson_realm = "rise"
entity_id = "ghost-drone"

# The zenoh-bridge-remote-api must be running alongside zenohd.
# Default WebSocket endpoint: ws://localhost:10001
# Configure the frontend via URL params: ?remote_api=ws://host:port
